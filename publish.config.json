{
  "site": {
    "type": "static",
    "entry": "index.html",
    "build": null,
    "spa": false,
    "note": "纯静态，无构建步骤；仓库根目录即站点根目录"
  },
  "repo": {
    "mode": "new",
    "owner": "auto",
    "name": "ai-dev-7days",
    "subdir": null,
    "visibility": "public",
    "branch": "main",
    "description": "纯前端 AI 应用开发 7 天实训：21 个自动判分关卡 + 7 个闭卷挑战 + 56 道自测题 + 180 条命令词典 + 浏览器内置 AI 沙盒终端（conda / pip / git / nvidia-smi）",
    "topics": ["ai", "tutorial", "conda", "git", "sandbox", "static-site", "chinese"],
    "commitPrefix": "deploy:",
    "note": "mode=new 建独立仓库（仓库根=站点根）；mode=existing 复用已有仓库，subdir 为空则发布到仓库根，subdir 有值则只更新该子目录，其余文件不动。name 写 auto 表示按文件夹名自动命名。"
  },
  "pages": {
    "provider": "github",
    "path": "/",
    "customDomain": null,
    "note": "GitHub 免费账号需 public 仓库才能开 Pages；私有仓库请把 provider 改成 cloudflare"
  },
  "include": [
    "index.html",
    "css/**",
    "js/**",
    "tools/**",
    "README.md",
    "PUBLISH.md",
    "publish.config.json",
    "deploy.ps1",
    ".gitignore"
  ],
  "exclude": ["_*", ".git/**", "node_modules/**", "*.out"],
  "verify": ["{url}", "{url}js/app.js", "{url}js/i18n.js", "{url}js/sandbox.js", "{url}js/data/d7.js", "{url}js/data/glossary.js", "{url}js/data/guide.js", "{url}js/data/quiz/d1.js", "{url}js/data/en.js", "{url}js/data/en/d1.js", "{url}js/data/en/glossary.js", "{url}css/app.css"],
  "report": {
    "printShareUrl": true,
    "writeBackToReadme": true
  }
}
